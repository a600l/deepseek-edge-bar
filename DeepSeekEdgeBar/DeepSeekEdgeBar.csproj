<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF.NotifyIcon" Version="1.0.2.510" />
  </ItemGroup>

  <ItemGroup>
    <!-- The usage parser's entry point (BuildSnapshot) is internal so tests can feed it
         recorded JSON without a network round trip. -->
    <InternalsVisibleTo Include="DeepSeekEdgeBar.Tests" />
  </ItemGroup>

</Project>
