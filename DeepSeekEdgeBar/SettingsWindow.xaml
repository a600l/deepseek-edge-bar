<Window x:Class="DeepSeekEdgeBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeepSeekEdgeBar"
        mc:Ignorable="d"
        Title="DeepSeek Edge Bar — Settings"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#FF0B1120" Foreground="#FFF8FAFC"
        FontFamily="Segoe UI" FontSize="13"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="DeepSeek Edge Bar — Settings"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#FFF8FAFC"
                       Padding="12,10,12,10"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Content="✕"
                    Background="Transparent"
                    Foreground="#FF94A3B8"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="12,4"
                    Click="CloseButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <TextBlock Text="DeepSeek account"
                       FontSize="11" Foreground="#FF94A3B8"/>
            <TextBlock Text="Optional — unlocks account info. Session token stored locally, never your password."
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0"/>
            <TextBox x:Name="AccountEmailBox"
                     Height="30" Margin="0,6,0,0" Padding="6"
                     Background="#FF0B1120" Foreground="#FFF8FAFC"
                     BorderBrush="#FF1F2A44" BorderThickness="1"/>
            <PasswordBox x:Name="AccountPasswordBox"
                         Height="30" Margin="0,6,0,0" Padding="6"
                         Background="#FF0B1120" Foreground="#FFF8FAFC"
                         BorderBrush="#FF1F2A44" BorderThickness="1"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SignInButton"
                        Content="Sign in"
                        Width="90" Height="30" Margin="0,0,8,0"
                        Background="#FF22C55E" Foreground="#FF07140B"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="SignInButton_Click"/>
                <Button x:Name="SignOutButton"
                        Content="Sign out"
                        Width="90" Height="30"
                        Background="#FF101828" Foreground="#FFF8FAFC"
                        BorderBrush="#FF1F2A44" BorderThickness="1"
                        Cursor="Hand"
                        Click="SignOutButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="AccountStatus"
                       FontSize="11" Foreground="#FF94A3B8"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Rectangle Height="1" Fill="#FF1F2A44" Margin="0,10,0,0"/>
            <TextBlock Text="Use a browser session token (Google-apple accounts)"
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,10,0,0"/>
            <TextBlock Text="Copy userToken, then paste it here:"
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0"/>
            <TextBox x:Name="TokenBox"
                     Height="30" Margin="0,6,0,0" Padding="6"
                     Background="#FF0B1120" Foreground="#FFF8FAFC"
                     BorderBrush="#FF1F2A44" BorderThickness="1"
                     FontFamily="Consolas" FontSize="11"
                     ToolTip="1. Sign in to chat.deepseek.com with a Google/Apple account.&#x0a;2. Press F12 to open DevTools.&#x0a;3. Open Application → Local Storage → https://chat.deepseek.com.&#x0a;4. Find the key named userToken and copy its value.&#x0a;5. Paste it here and click Use token."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="UseTokenButton"
                        Content="Use token"
                        Width="90" Height="30"
                        Background="#FF22C55E" Foreground="#FF07140B"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="UseTokenButton_Click"/>
            </StackPanel>

            <TextBlock Text="DeepSeek Platform token (usage stats)"
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,18,0,0"/>
            <TextBlock Text="Optional — unlocks per-model token usage, requests, and cost tracking."
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0"/>
            <TextBox x:Name="PlatformTokenBox"
                     Height="30" Margin="0,6,0,0" Padding="6"
                     Background="#FF0B1120" Foreground="#FFF8FAFC"
                     BorderBrush="#FF1F2A44" BorderThickness="1"
                     FontFamily="Consolas" FontSize="11"
                     ToolTip="1. Sign in to platform.deepseek.com.&#x0a;2. Press F12 to open DevTools.&#x0a;3. Open Application → Local Storage → https://platform.deepseek.com.&#x0a;4. Find the key named userToken and copy its value.&#x0a;5. Paste it here and click Use platform token."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="UsePlatformTokenButton"
                        Content="Use platform token"
                        Width="130" Height="30"
                        Background="#FF22C55E" Foreground="#FF07140B"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="UsePlatformTokenButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="PlatformStatus"
                       FontSize="11" Foreground="#FF94A3B8"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock Text="API key" Margin="0,18,0,0"
                       FontSize="11" Foreground="#FF94A3B8"/>
            <TextBlock Text="Stored locally in Windows Registry — never shared."
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0"/>
            <PasswordBox x:Name="ApiKeyBox"
                         Height="30" Margin="0,6,0,0" Padding="6"
                         Background="#FF0B1120" Foreground="#FFF8FAFC"
                         BorderBrush="#FF1F2A44" BorderThickness="1"/>

            <TextBlock Text="Opacity"
                       Margin="0,14,0,0"
                       FontSize="11" Foreground="#FF94A3B8"/>
            <TextBlock Text="Drop the widget opacity for an always-visible peek."
                       FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                <Slider x:Name="OpacitySlider"
                        Width="220" Minimum="0.2" Maximum="1.0" Value="1.0"/>
                <TextBlock x:Name="OpacityValue"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" Width="40"/>
            </StackPanel>

            <CheckBox x:Name="HideToTrayCheck" Content="Hide to tray on close"
                      Foreground="#FFF8FAFC" Margin="0,14,0,0"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                      Foreground="#FFF8FAFC" Margin="0,8,0,0"/>

            <TextBlock Text="Edge to dock on startup"
                       Margin="0,14,0,0"
                       FontSize="11" Foreground="#FF94A3B8"/>
            <ComboBox x:Name="EdgeCombo"
                      Margin="0,6,0,0" Width="140" HorizontalAlignment="Left"
                      Background="#FF101828" Foreground="#FFF8FAFC"
                      BorderBrush="#FF1F2A44" BorderThickness="1">
                <ComboBoxItem Content="Right"/>
                <ComboBoxItem Content="Left"/>
            </ComboBox>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Content="Save"
                        Width="90" Height="30" Margin="0,0,8,0"
                        Background="#FF22C55E" Foreground="#FF07140B"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="Cancel"
                        Width="90" Height="30"
                        Background="#FF101828" Foreground="#FFF8FAFC"
                        BorderBrush="#FF1F2A44" BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>