<Window x:Class="DeepSeekEdgeBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Edge Bar"
        Width="6"
        MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="MainWindow_Loaded">
    <Grid>
        <Border x:Name="collapsedStrip"
                Width="6"
                MinWidth="6"
                HorizontalAlignment="Left"
                Background="#FF64748B"
                Cursor="Hand"
                ToolTip="Click to view status"
                Opacity="0.85"
                MouseEnter="CollapsedStrip_MouseEnter"
                MouseLeave="CollapsedStrip_MouseLeave">
            <Border x:Name="Grip"
                    Width="2"
                    Height="18"
                    Background="#40FFFFFF"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
        </Border>

        <Border x:Name="expandedPanel"
                Width="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#FF0B1120"
                BorderBrush="#FF1F2A44"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Hidden">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel Margin="10">
                <DockPanel>
                    <Button x:Name="ExitButton"
                            Content="✕"
                            Width="26"
                            Height="26"
                            DockPanel.Dock="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF94A3B8"
                            Cursor="Hand"
                            Click="ExitButton_Click" />
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Width="26"
                            Height="26"
                            DockPanel.Dock="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF94A3B8"
                            Cursor="Hand"
                            Click="SettingsButton_Click" />
                    <Button x:Name="CollapseButton"
                            Content="‹"
                            Width="26"
                            Height="26"
                            DockPanel.Dock="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF94A3B8"
                            Cursor="Hand"
                            Click="CollapseButton_Click" />
                    <TextBlock Text="DeepSeek Edge Bar"
                               FontSize="11"
                               Foreground="#FF94A3B8"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Border CornerRadius="6"
                        Background="#FF101828"
                        BorderBrush="#FF1F2A44"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#FF64748B"
                                 VerticalAlignment="Center" />
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock x:Name="StatusValue"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF8FAFC" />
                            <TextBlock x:Name="StatusCountdown"
                                       FontSize="11"
                                       Foreground="#FF94A3B8"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="6"
                        Background="#FF101828"
                        BorderBrush="#FF1F2A44"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="BalanceValue"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF8FAFC"
                                   Text="—" />
                        <TextBlock x:Name="BalanceDetail"
                                   FontSize="11"
                                   Foreground="#FF94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="ApiKeyStatus"
                                   FontSize="11"
                                   Foreground="#FF64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="2,8,2,0" ToolTip="TODAY: last day of usage data · MO: current month · TOP: most-used model">
                    <TextBlock x:Name="UsageToday" FontSize="11" Foreground="#FF94A3B8" TextWrapping="Wrap" />
                    <TextBlock x:Name="UsageMonth" FontSize="11" Foreground="#FF94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="UsageTopModel" FontSize="11" Foreground="#FF94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="UsageHint" FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Margin="2,10,2,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center" />
                        <TextBlock Text="off-peak · lowest rates" FontSize="11" Foreground="#FF94A3B8" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="8" Height="8" Fill="#FFB91C1C" VerticalAlignment="Center" />
                        <TextBlock Text="peak · 2× rates" FontSize="11" Foreground="#FF94A3B8" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="8" Height="8" Fill="#FFEF4444" VerticalAlignment="Center" />
                        <TextBlock Text="problem · low balance / offline" FontSize="11" Foreground="#FF94A3B8" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF64748B" VerticalAlignment="Center" />
                        <TextBlock Text="no API key" FontSize="11" Foreground="#FF94A3B8" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <DockPanel Margin="2,10,2,0">
                    <Button x:Name="RefreshButton"
                            Content="⟳"
                            Width="22" Height="22"
                            DockPanel.Dock="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#FF94A3B8"
                            Cursor="Hand"
                            Click="RefreshButton_Click" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock x:Name="ModelValue" FontSize="11" Foreground="#FF94A3B8" Text="—" />
                        <TextBlock Text=" · " FontSize="11" Foreground="#FF94A3B8" />
                        <TextBlock x:Name="LastRefresh" FontSize="11" Foreground="#FF94A3B8" Text="—" />
                    </StackPanel>
                    <TextBlock x:Name="AccountLine" FontSize="11" Foreground="#FF94A3B8" Text="" Margin="0,2,0,0"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>