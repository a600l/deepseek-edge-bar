<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts. DeepSeek ships DM Sans (marketing) and Inter (platform); neither is a
         Windows system font so we fall back to the same stack their sites use. -->
    <FontFamily x:Key="BarFontFamily">DM Sans, Inter, Segoe UI, system-ui, sans-serif</FontFamily>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BarBackgroundBrush" Color="#FF121C31" />
    <SolidColorBrush x:Key="BarSurfaceBrush" Color="#FF1C2A47" />
    <SolidColorBrush x:Key="BarBorderBrush" Color="#FF2B3D5E" />
    <SolidColorBrush x:Key="BarBrandBrush" Color="#FF3964FE" />
    <SolidColorBrush x:Key="BarBrandLightBrush" Color="#FF4176E6" />

    <!-- Text. Secondary/muted are chosen to clear WCAG AA (4.5:1) on BarBackgroundBrush:
         secondary 7.7:1, muted 7.1:1. -->
    <SolidColorBrush x:Key="BarTextPrimaryBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="BarTextSecondaryBrush" Color="#FF9FB2CE" />
    <SolidColorBrush x:Key="BarTextMutedBrush" Color="#FF8FA0B8" />

    <!-- Status colours. Also consumed by code-behind via FindResource so the legend
         and the live indicator can never drift apart. -->
    <SolidColorBrush x:Key="BarStatusGreenBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="BarStatusPeakBrush" Color="#FFB91C1C" />
    <SolidColorBrush x:Key="BarStatusErrorBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="BarStatusIdleBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="BarAccentTextBrush" Color="#FFFFFFFF" />

    <!-- Chrome-less icon button: transparent at rest, visible hover/pressed/disabled
         states so the icons feel clickable. Keyboard focus is drawn explicitly because
         the default template's focus visual is invisible on this dark surface. -->
    <Style x:Key="BarIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource BarTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource BarTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BarStatusGreenBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action button used by the settings dialog. Brand blue, per DeepSeek's
         own calls-to-action on deepseek.com / platform. -->
    <Style x:Key="BarPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{StaticResource BarBrandBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BarAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BarBrandLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary/neutral button used by the settings dialog. -->
    <Style x:Key="BarSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{StaticResource BarSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BarTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BarSurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BarBrandLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BarBrandBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BarBrandBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BarAccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Field label / helper text pairing used throughout the settings dialog. -->
    <Style x:Key="BarFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BarTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,18,0,0" />
    </Style>

    <Style x:Key="BarFieldHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BarTextMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BarTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource BarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BarTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource BarTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
